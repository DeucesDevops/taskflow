# TEMPLATE ONLY: fill with unique values and apply from a private path.
# Do not commit a populated copy. Passwords must be URL-safe because the app
# constructs PostgreSQL and AMQP connection URLs from them.
apiVersion: v1
kind: Secret
metadata:
  name: taskflow-secrets
  namespace: taskflow
type: Opaque
stringData:
  POSTGRES_PASSWORD: REPLACE_WITH_UNIQUE_URL_SAFE_DATABASE_PASSWORD
  RABBITMQ_PASSWORD: REPLACE_WITH_UNIQUE_URL_SAFE_BROKER_PASSWORD
  JWT_SECRET: REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
  DEMO_PASSWORD: REPLACE_WITH_UNIQUE_BOOTSTRAP_PASSWORD
