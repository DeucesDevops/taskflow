# TEMPLATE ONLY: apply after replacing the ACM certificate ARN and DNS host.
# AWS Load Balancer Controller reconciles this Ingress into an internet-facing ALB.
# Instance targets require the NGINX controller Service to be NodePort.
apiVersion: networking.k8s.io/v1
kind: Ingress
metadata:
  name: taskflow-alb
  namespace: nginx-ingress
  annotations:
    alb.ingress.kubernetes.io/scheme: internet-facing
    alb.ingress.kubernetes.io/target-type: instance
    alb.ingress.kubernetes.io/listen-ports: '[{"HTTP":80},{"HTTPS":443}]'
    alb.ingress.kubernetes.io/certificate-arn: REPLACE_WITH_ACM_CERTIFICATE_ARN
    alb.ingress.kubernetes.io/ssl-redirect: "443"
    alb.ingress.kubernetes.io/healthcheck-path: /nginx-health
    alb.ingress.kubernetes.io/success-codes: "200"
spec:
  ingressClassName: alb
  rules:
    - host: taskflow.deuces.dev
      http:
        paths:
          - path: /
            pathType: Prefix
            backend:
              service:
                name: taskflow-nginx-nginx-ingress-controller
                port:
                  number: 80
